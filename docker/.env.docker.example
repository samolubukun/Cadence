# Cadence Local Docker Environment Configuration
# Copy this to .env.local to route Cadence Next.js frontend to your local Docker services

APP_URL=http://localhost:3000
CADENCE_API_KEY=cadence-secret-key

# ---------------------------------------------------------------------------
# S3 & Object Storage (Local MinIO or AWS S3 / Cloudflare R2)
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=cadence
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Monolith Combined Endpoints (docker-compose.combined.yml on port 8000)
# ---------------------------------------------------------------------------
CADENCE_API_URL=http://localhost:8000
CADENCE_SOUND_API_URL=http://localhost:8000/sound
CADENCE_SONG_API_URL=http://localhost:8000/song
CADENCE_MEDIA_API_URL=http://localhost:8000/media
CADENCE_STUDIO_API_URL=http://localhost:8000/studio
CADENCE_CLIPPER_API_URL=http://localhost:8000/clipper
CADENCE_AGENT_API_URL=http://localhost:8000/agent
CADENCE_AGENT_WS_URL=ws://localhost:8000/agent/ws/realtime
CADENCE_QWEN_IMAGE_API_URL=http://localhost:8000/qwen
CADENCE_SENSENOVA_API_URL=http://localhost:8000/sensenova

# ---------------------------------------------------------------------------
# Modular Microservice Endpoints (uncomment when using docker-compose.modular.yml)
# ---------------------------------------------------------------------------
# CADENCE_API_URL=http://localhost:8001
# CADENCE_SOUND_API_URL=http://localhost:8001/sound
# CADENCE_SONG_API_URL=http://localhost:8001/song
# CADENCE_MEDIA_API_URL=http://localhost:8001/media
